{
    "manifest_version": 3,
    "name": "Copy Page Title",
    "version": "2.5",
    "description": "One-click copy of the page title.",

    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "iconx128.png"
    },

    "permissions": [
        "activeTab",
        "scripting",
        "clipboardWrite",
        "contextMenus"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "action": {
        "default_icon": {
            "16": "iconx128.png",
            "48": "iconx128.png",
            "128": "iconx128.png"
        }
    },

    "commands": {
        "copy-title": {
            "description": "Copy Title"
        },
        "copy-url": {
            "description": "Copy URL"
        },
        "copy-title-url": {
            "suggested_key": {
                "default": "Ctrl+Shift+F",
                "mac": "MacCtrl+Shift+F"
            },
            "description": "Copy Title + URL"
        },
        "copy-markdown": {
            "description": "Copy Markdown"
        },
        "copy-raw": {
            "description": "Copy RAW"
        }
    },

    "background": {
        "service_worker": "background.js"
    }
}